  m_Script: {fileID: 11500000, guid: fa5767a0154cc254e90972593787acc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  title: "\u7F34\u8D39\u6536\u636E\u5B58\u6839 \xB7 \u7B2C\u3007\u56DB\u4E00\u4E8C\u53F7"
  evidenceId: Y02
  source: "\u4E8B\u52A1\u5BA4\u7F34\u8D39\u7A97\u53E3 \xB7 \u6536\u636E\u5B58\u6839\u7C3F\uFF08\u533B\u9662\u7559\u5B58\u8054\uFF09"
  body: "\u6536\u6B3E\u65E5\u671F\uFF1A\u4E00\u4E5D\u4E09\u4E00\u5E74\u4E00\u6708\u4E8C\u5341\u65E5\n\u6536\u6B3E\u65F6\u523B\uFF1A\u4E0B\u5348\u56DB\u65F6\u96F6\u4E03\u5206\n\u4F4F\u9662\u53F7\uFF1AC-017\uFF08\u513F\u7AE5\u75C5\u623F\uFF09\n\u6B3E\u9879\uFF1A\u62A4\u7406\u53CA\u81B3\u98DF\u8D39\uFF0C\u9884\u4ED8\u81F3\u56DB\u6708\u4E09\u5341\u65E5\n\u91D1\u989D\uFF1A\u56DB\u5341\u5143\u6574\uFF08\u73B0\u6B3E\uFF09\n\u4EA4\u6B3E\u4EBA\uFF1A\u6BCD\u4EB2\uFF08\u4EB2\u7B14\u7B7E\u540D\uFF09\u3000\u7ECF\u624B\uFF1A\u4E8B\u52A1\u5458\n\n\u5907\u6CE8\uFF1A\u4EA4\u6B3E\u4EBA\u5631\u5490\uFF0C\u5BB6\u91CC\u82E5\u6709\u53D8\u52A8\uFF0C\u8BF7\u9662\u91CC\u5148\u7167\u987E\u5B69\u5B50\u3002\n\n\u672C\u5BA4\u6536\u6B3E\u65F6\u523B\u7167\u5BA4\u5185\u6302\u949F\u586B\u5199\uFF1B\u6302\u949F\u6BCF\u65E5\u6B63\u5348\u968F\u949F\u697C\u62A5\u65F6\u6821\u51C6\u3002"
  illustration: {fileID: 2800000, guid: fb935d972cbed4dfc841397a7c79edf2, type: 3}
  reverse: {fileID: 0}
