  m_Script: {fileID: 11500000, guid: fa5767a0154cc254e90972593787acc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  title: "\u63A2\u89C6\u767B\u8BB0\u7C3F \xB7 \u4E00\u6708\u4E8C\u5341\u65E5"
  evidenceId: Y01
  source: "\u95E8\u5385\u95EE\u8BAF\u53F0 \xB7 \u95E8\u623F\u4FDD\u7BA1\u7684\u767B\u8BB0\u7C3F\uFF08\u5BB6\u5C5E\u53EF\u770B\u672C\u5BB6\u6761\u76EE\uFF09"
  body: "\u4E00\u4E5D\u4E09\u4E00\u5E74\u4E00\u6708\u4E8C\u5341\u65E5\u3000\u793C\u62DC\u4E8C\n\u513F\u7AE5\u75C5\u623F\u975E\u63A2\u89C6\u65E5\u3002\u5BB6\u5C5E\u51ED\u62A4\u58EB\u957F\u7279\u8BB8\u6761\u6216\u966A\u62A4\u8BC1\u8FDB\u5165\u3002\n\n\u5E8A\u4F4D\uFF1A\u513F\u7AE5\u75C5\u623F
    C-017\n14:10 \u8FDB\u3000\u6BCD\u4EB2\u3000\uFF08\u7279\u8BB8\u6761\u7B2C\u4E09\u53F7\uFF09\n15:35
    \u51FA\u3000\u6BCD\u4EB2\u3000\u5F80\u7F34\u8D39\u7A97\u53E3\n16:20 \u8FDB\u3000\u7236\u4EB2\u3000\uFF08\u966A\u62A4\u8BC1\uFF09\n16:55
    \u51FA\u3000\u7236\u4EB2\u3000\u501F\u770B\u8F66\u7AD9\u65F6\u523B\u8868\n\n\u672C\u7C3F\u65F6\u523B\u6309\u95E8\u623F\u6000\u8868\u586B\u5199\u3002\u95E8\u623F\u7684\u8868\u6BCF\u65E5\u65E9\u6668\u5728\u8F66\u7AD9\u5BF9\u65F6\u3002"
  illustration: {fileID: 2800000, guid: ff55310bd3e2a493ca1b1f5b052b7eef, type: 3}
  reverse: {fileID: 0}
