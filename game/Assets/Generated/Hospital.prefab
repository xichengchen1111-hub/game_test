--- !u!114 &2851727150908872809
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7394905541490207538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa5767a0154cc254e90972593787acc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  title: "\u5B69\u5B50\u7684\u753B"
  evidenceId: Y03
  source: "\u513F\u7AE5\u75C5\u623F \xB7 \u9760\u9662\u5B50\u7B2C\u4E09\u5E8A\u7684\u5E8A\u4E0A\u5C0F\u684C"
  body: "\u6B63\u9762\uFF1A\u4E00\u5EA7\u623F\u5B50\u3001\u4E09\u4E2A\u4EBA\u548C\u4E00\u8F86\u5C0F\u6C7D\u8F66\u3002\u4E2D\u95F4\u7684\u4EBA\u624B\u91CC\u63D0\u7740\u4E00\u53EA\u753B\u6EE1\u7EA2\u5708\u7684\u7BEE\u5B50\u3002\u592A\u9633\u8FD8\u6CA1\u6709\u6D82\u8272\u3002\n\n\u80CC\u9762\uFF0C\u94C5\u7B14\uFF0C\u5B69\u5B50\u7684\u5B57\uFF1A\n\u4E00\u6708\u4E8C\u5341\u65E5\u3000\u793C\u62DC\u4E8C\u3000\u4E0B\u5348\n\u5988\u5988\u6765\u4E86\uFF0C\u5E26\u4E86\u4E00\u7BEE\u82F9\u679C\u3002\n\u5988\u5988\u8BF4\u4E0B\u56DE\u5E26\u91D1\u8272\u7684\u8721\u7B14\u6765\uFF0C\u7ED9\u592A\u9633\u6D82\u3002"
