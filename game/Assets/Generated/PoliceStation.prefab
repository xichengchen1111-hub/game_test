--- !u!114 &4597534466179775608
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 362980248445032143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d92f7353446fa3a49a5156b0d9400667, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoliceDocumentItem
  title: "\u6848\u5377\u6458\u8981\uFF08\u526F\u672C\uFF09"
  evidenceId: E01
  source: "\u9752\u5DDD\u8B66\u7F72\u5BF9\u7167\u684C \xB7 \u4E0E\u516C\u5F00\u6750\u6599\u684C\u540C\u4E00\u4EFD\u6458\u8981\u526F\u672C"
  body: "\u4E00\u4E5D\u4E09\u4E00\u5E74\u4E00\u6708\u4E8C\u5341\u65E5\u591C\uFF0C\u4E00\u540D\u5987\u4EBA\u6B7B\u4E8E\u81EA\u5BB6\u4F1A\u5BA2\u5BA4\uFF0C\u7531\u4E08\u592B\u53D1\u73B0\uFF0C\u90BB\u5C45\u592B\u5987\u968F\u540C\u8FDB\u5C4B\u3002\u6B7B\u8005\u906D\u949D\u5668\u88AD\u51FB\uFF0C\u6B7B\u4EA1\u65F6\u95F4\u53EA\u80FD\u4F30\u4E3A\u508D\u665A\u4E00\u6BB5\u8F83\u5BBD\u7684\u65F6\u6BB5\u3002\u524D\u540E\u95E8\u65E0\u5F3A\u884C\u8FDB\u5165\u75D5\u8FF9\uFF1B\u5BB6\u5177\u5C40\u90E8\u7FFB\u4E71\uFF0C\u6536\u6B3E\u62BD\u5C49\u88AB\u6253\u5F00\uFF1B\u73B0\u573A\u6709\u4E08\u592B\u7684\u65E7\u5916\u5957\u3001\u4FEE\u8F66\u5320\u5DE5\u5177\u724C\u3001\u673A\u6CB9\u624B\u5957\u548C\u4E00\u5C01\u88AB\u88C1\u53BB\u4E0A\u4E0B\u6587\u7684\u4FE1\uFF08\u7167\u7247\u9644\u5377\uFF09\u3002\n\u4E08\u592B\u9648\u8FF0\uFF08\u6458\u8981\uFF09\uFF1A\u4E8C\u5341\u65E5\u7EA6\u4E94\u65F6\u4E09\u5341\u4E94\u5206\u79BB\u5BB6\uFF0C\u5230\u8F66\u7AD9\u4E58\u8F66\uFF0C\u8D74\u53E6\u4E00\u9547\u5357\u533A\u201C\u4E1C\u8857\u201D\u4E4B\u7EA6\uFF0C\u5230\u4E86\u624D\u77E5\u90A3\u91CC\u6CA1\u6709\u4E1C\u8857\uFF1B\u51FA\u793A\u4E00\u6708\u4E8C\u5341\u65E5\u8F66\u7968\u4E00\u5F20\uFF1B\u516B\u65F6\u56DB\u5341\u5206\u524D\u540E\u56DE\u5BB6\uFF0C\u4E0E\u90BB\u5C45\u592B\u5987\u4E00\u540C\u8FDB\u5C4B\u53D1\u73B0\u59BB\u5B50\u3002\n\u9001\u5976\u5C11\u5E74\u8BC1\u8A00\uFF08\u6458\u8981\uFF09\uFF1A\u4E8C\u5341\u65E5\u508D\u665A\u9001\u5976\u5230\u8BE5\u6237\uFF0C\u59BB\u5B50\u4EB2\u624B\u63A5\u8FC7\u725B\u5976\uFF0C\u65F6\u4E3A\u516D\u70B9\u4E8C\u5341\u4E94\u5206\u3002\n\u4E08\u592B\u7ECF\u77ED\u6682\u7F81\u62BC\u540E\u83B7\u51C6\u4FDD\u91CA\uFF0C\u914D\u5408\u8C03\u67E5\u3002"
  illustration: {fileID: 2800000, guid: d6e9491da44de43f9b8331debf5246b5, type: 3}
  reverse: {fileID: 0}
  documentId: e01-compare
  paperAudio: {fileID: 5866897978207835213}
