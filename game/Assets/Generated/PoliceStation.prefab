  m_Script: {fileID: 11500000, guid: 03ea40d7ae8724b2cb9eb7d67cfc5074, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningNewspaper
  title: "\u9752\u5DDD\u65E5\u62A5 \xB7 \u59BB\u5B50\u9047\u5BB3\u62A5\u9053"
  evidenceId: opening-newspaper
  source: "\u5F8B\u5E08\u5E26\u6765\u7684\u9752\u5DDD\u65E5\u62A5\uFF08\u6848\u4EF6\u62A5\u9053\uFF1B\u5177\u4F53\u520A\u65E5\u672A\u6807\u6CE8\uFF09"
  body: "\u672C\u9547\u4E00\u540D\u5987\u4EBA\u4E8E\u4E00\u6708\u4E8C\u5341\u65E5\u591C\u95F4\u88AB\u53D1\u73B0\u6B7B\u4E8E\u81EA\u5BB6\u4F1A\u5BA2\u5BA4\u3002\u53D1\u73B0\u8005\u4E3A\u5176\u4E08\u592B\uFF0C\u90BB\u5C45\u592B\u5987\u4EA6\u5728\u573A\u3002\u8B66\u65B9\u5DF2\u95EE\u8BAF\u4E08\u592B\uFF0C\u5E76\u6838\u67E5\u5176\u5F53\u665A\u884C\u7A0B\u3002\n\n\u4F4F\u5B85\u5185\u6709\u5C40\u90E8\u7FFB\u4E71\u75D5\u8FF9\uFF0C\u524D\u540E\u95E8\u672A\u53D1\u73B0\u660E\u663E\u5F3A\u884C\u8FDB\u5165\u75D5\u8FF9\u3002\u6B7B\u4EA1\u65F6\u523B\u5C1A\u672A\u786E\u5B9A\uFF0C\u8B66\u65B9\u4ECD\u5728\u6536\u96C6\u6750\u6599\u3002\n\n\u9547\u4E0A\u6709\u4EBA\u8C08\u53CA\u6B7B\u8005\u7684\u5BB6\u5EAD\u7EB7\u4E89\uFF0C\u4EA6\u6709\u4EBA\u5C06\u6B64\u6848\u4E0E\u4E00\u540D\u4FEE\u8F66\u5320\u8054\u7CFB\u8D77\u6765\u3002\u8FD9\u4E9B\u4F20\u95FB\u5C1A\u4E0D\u80FD\u8BF4\u660E\u8C01\u5B9E\u65BD\u4E86\u88AD\u51FB\u3002\n\n\u672C\u62A5\u63D0\u9192\uFF1A\u6848\u60C5\u4ECD\u5728\u8C03\u67E5\uFF0C\u4F20\u8A00\u4E0E\u5DF2\u6838\u5B9E\u7684\u4E8B\u5B9E\u5E94\u52A0\u4EE5\u533A\u522B\u3002"
  illustration: {fileID: 0}
  reverse: {fileID: 0}
