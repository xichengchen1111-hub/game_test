  m_Script: {fileID: 11500000, guid: d92f7353446fa3a49a5156b0d9400667, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoliceDocumentItem
  title: "\u4E24\u4F4D\u987E\u5BA2\u7684\u8BC1\u8BCD\uFF08\u6284\u4EF6\uFF09"
  evidenceId: W02
  source: "\u4FEE\u8F66\u94FA\u8D26\u623F \xB7 \u4E66\u684C \xB7 \u90BB\u5E02\u51EF\u6069\u8F66\u95F4\u5BC4\u6765\u7684\u6284\u4EF6"
  body: "\u4E24\u4F4D\u987E\u5BA2\u7684\u8BC1\u8BCD\uFF08\u6284\u4EF6\uFF09\n\n\u987E\u5BA2\u7532\uFF08\u53D6\u6469\u6258\u8F66\uFF09\uFF1A\n\u201C\u89C1\u8FC7\u3002\u6211\u516D\u70B9\u53BB\u53D6\u6469\u6258\uFF0C\u4ED6\u8FD8\u5728\u7ED9\u6211\u7684\u8F66\u6362\u76AE\u5E26\u3002\u6211\u62FF\u8D70\u8F66\u65F6\uFF0C\u4ED6\u6CA1\u79BB\u5F00\u5DE5\u4F4D\u3002\u201D\n\n\u987E\u5BA2\u4E59\uFF08\u4ED8\u4FEE\u8F66\u8D26\uFF09\uFF1A\n\u201C\u4E03\u70B9\u524D\u6211\u53BB\u4ED8\u8D26\u3002\u4ED6\u8FD8\u5728\u3002\u6211\u540E\u6765\u628A\u6536\u636E\u5BC4\u7ED9\u8B66\u7F72\u4E86\uFF0C\u6536\u636E\u4E0A\u6709\u8F66\u95F4\u7684\u90AE\u6233\u3002\u201D\n\u201C\u6536\u636E\u65E5\u671F\u3001\u6211\u4F4F\u7684\u65C5\u5E97\u767B\u8BB0\u548C\u90A3\u73ED\u672B\u73ED\u8F66\u90FD\u5BF9\u5F97\u4E0A\u3002\u9547\u4E0A\u8B66\u5BDF\u6765\u95EE\u8FC7\uFF0C\u6211\u4E5F\u628A\u539F\u4EF6\u7ED9\u4ED6\u4EEC\u770B\u4E86\u3002\u201D\n\n\u95EE\u8BDD\u8BB0\u5F55\u539F\u4EF6\u5B58\u9752\u5DDD\u8B66\u7F72\u3002"
  illustration: {fileID: 2800000, guid: ae3488b2f02c86b4dacf1293fa4c2df5, type: 3}
  reverse: {fileID: 0}
  documentId: w02
  paperAudio: {fileID: 5517314326756808185}
