  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d92f7353446fa3a49a5156b0d9400667, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoliceDocumentItem
  title: "\u65C5\u9986\u767B\u8BB0\u7C3F\uFF08\u4E00\u6708\u4E8C\u5341\u65E5\u90A3\u9875\uFF09"
  evidenceId: I01
  source: "\u9752\u5DDD\u65C5\u9986\u767B\u8BB0\u5927\u5802 \xB7 \u67E5\u9605\u684C\u4E0A\u644A\u5F00\u7684\u767B\u8BB0\u7C3F"
  body: "\u9752\u5DDD\u65C5\u9986\u3000\u65C5\u5BA2\u767B\u8BB0\u7C3F\n\u4E00\u4E5D\u4E09\u4E00\u5E74\u4E00\u6708\u4E8C\u5341\u65E5\u3000\u661F\u671F\u4E8C\n\u5230\u5E97\u949F\u70B9\u7531\u95E8\u623F\u7167\u81EA\u5DF1\u7684\u6000\u8868\u586B\u5199\uFF1B\u95E8\u623F\u6BCF\u5929\u65E9\u4E0A\u5230\u8F66\u7AD9\u5BF9\u8868\u3002\u59D3\u540D\u4E0E\u6765\u5904\u7531\u65C5\u5BA2\u81EA\u586B\u3002\n\n\u4E0A\u5348\u5341\u65F6\u4E8C\u5341\u5206\u3000\u8D6B\u4F2F\u7279\xB7\u83B1\u6069\u3000\u6765\u81EA\u90BB\u5E02\u3000\u4E8C\u53F7\u623F\u3000\u4F4F\u4E24\u665A\n\u4E0B\u5348\u4E8C\u65F6\u4E94\u5206\u3000\u739B\u838E\xB7\u79D1\u5C14\u592A\u592A\u3000\u6765\u81EA\u5357\u8FB9\u4E61\u4E0B\u3000\u4E09\u53F7\u623F\u3000\u63A2\u4EB2\n\u4E0B\u5348\u56DB\u65F6\u56DB\u5341\u5206\u3000\u5F17\u5170\u514B\u3001\u8D1D\u514B\uFF08\u63A8\u9500\u5458\u4E8C\u4F4D\uFF09\u3000\u6765\u81EA\u90BB\u5E02\u3000\u4E00\u53F7\u623F\u3000\u4E00\u665A\n\u665A\u4E0A\u4E00\u884C\uFF1AH\xB7\u534E\u5FB7\u3000\u9014\u7ECF\u3000\u516D\u53F7\u623F\u3000\u5019\u591C\u8F66\u3002\u5230\u5E97\u949F\u70B9\u4E00\u680F\u7684\u58A8\u8FF9\u6655\u5F00\u4E86\uFF0C\u50CF\u662F\u538B\u8FC7\u5438\u58A8\u7EB8\uFF0C\u80FD\u8BA4\u51FA\u7684\u662F\u201C\u516B\u65F6\u5341\u4E94\u5206\u201D\u3002\n\n\u8FD9\u4E00\u9875\u7684\u9875\u89D2\u5411\u4E0B\u6298\u8D77\u3002"
  illustration: {fileID: 2800000, guid: e77acc51c3aaf18498e504fba9c6840d, type: 3}
  reverse: {fileID: 0}
  documentId: i01
  paperAudio: {fileID: 8489224513746891679}
