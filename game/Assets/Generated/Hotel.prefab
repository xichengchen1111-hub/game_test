  m_Script: {fileID: 11500000, guid: d92f7353446fa3a49a5156b0d9400667, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoliceDocumentItem
  title: "\u9910\u5385\u8D26\u672C\uFF08\u4E00\u6708\u4E8C\u5341\u65E5\u665A\uFF09"
  evidenceId: I03
  source: "\u9752\u5DDD\u65C5\u9986\u9910\u5385 \xB7 \u8D26\u684C"
  body: "\u9910\u5385\u8D26\u684C\u3000\u4E00\u6708\u4E8C\u5341\u65E5\u3000\u661F\u671F\u4E8C\u3000\u665A\n\u6536\u6B3E\u949F\u70B9\u7167\u95E8\u623F\u7684\u8868\u8BB0\uFF1B\u8001\u677F\u5A18\u6BCF\u5929\u508D\u665A\u5411\u95E8\u623F\u5BF9\u4E00\u6B21\u8868\u3002\n\n\u516D\u65F6\u4E94\u5206\u3000\u4E8C\u53F7\u623F\u3000\u83B1\u6069\u5148\u751F\u3000\u665A\u9910\u4E00\u5BA2\uFF08\u7096\u725B\u8089\uFF09\u3000\u8BB0\u623F\u8D26\n\u516D\u65F6\u4E09\u5341\u5206\u3000\u4E00\u53F7\u623F\u3000\u63A8\u9500\u5458\u4E8C\u4F4D\u3000\u665A\u9910\u4E8C\u5BA2\u3000\u4ED8\u73B0\n\u516D\u65F6\u4E94\u5341\u5206\u3000\u516D\u53F7\u623F\u3000\u534E\u5FB7\u5148\u751F\u3000\u623F\u8D39\u4E00\u665A\uFF08\u9884\u4ED8\uFF09\uFF1B\u665A\u9910\uFF1A\u4E0D\u7528\u3000\u4ED8\u73B0\n\u4E03\u65F6\u5341\u5206\u3000\u4E09\u53F7\u623F\u3000\u79D1\u5C14\u592A\u592A\u3000\u8336\u70B9\u3000\u8BB0\u623F\u8D26\n\u4E03\u65F6\u56DB\u5341\u5206\u3000\u95E8\u5BA2\uFF08\u975E\u4F4F\u5BA2\uFF09\u3000\u665A\u9910\u4E00\u5BA2\u3000\u4ED8\u73B0\n\n\u672B\u884C\u662F\u8001\u677F\u5A18\u7684\u5B57\uFF1A\u201C\u665A\u996D\u516B\u65F6\u6536\uFF0C\u53A8\u623F\u516B\u65F6\u534A\u7184\u706B\u3002\u201D"
  illustration: {fileID: 2800000, guid: 3e5c8b9ca48c8f147a7ff6c3a98fc79a, type: 3}
