# Native player logs remain local; publish compact verification summaries.
output/demo/**/*.log

# Editable source is kept; automatic Blender recovery versions stay local.
assets/source/greenery/*.blend[0-9]
assets/source/milkboy/tripo/*.blend[0-9]
assets/source/watchmaker/tripo/*.blend[0-9]
assets/source/station-clerk/tripo/*.blend[0-9]

# Repository size (REPO-01, 2026-10-12): new evidence frames, videos and archives under output/
# stay out of Git. Commit selected frames as JPG (tools/evidence_jpg.py); keep videos and raw
# archives in builds/ or share them outside Git. Files that are already tracked are unaffected.
output/**/*.png
output/**/*.mp4
output/**/*.mov
output/**/*.webm
output/**/*.gif
output/**/*.zip

# Police cast (2026-10-14): the raw Tripo downloads and their unpacked copies stay local, like other
# original download packages; production-status.json records their names and hashes.
assets/source/police-cast/*/tripo/original/
assets/source/police-cast/**/*.blend[0-9]
# Hospital cast (2026-10-14): the same rule; the archive names and hashes are in
# assets/source/hospital-cast/production-status.json, acceptance.json and each import-results.json.
assets/source/hospital-cast/*/tripo/original/
assets/source/hospital-cast/**/*.blend[0-9]
